// schema.prisma
// Prisma schema for IT Ticket Resolution Assistant

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Ticket {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  ticket_id        String    @unique
  title            String
  description      String
  raw_text         String?
  category         String
  subcategory      String
  priority         String
  intent           String    @default("Incident")
  affected_service String
  environment      String    @default("Production")
  status           String    @default("New")
  assignment_group String
  resolution_text  String?
  created_at       DateTime  @default(now())
  resolved_at      DateTime?
  source_type      String    @default("synthetic")
  data_access_level String   @default("internal")

  @@index([category, status])
  @@index([priority, created_at])
  @@index([affected_service])
  @@index([created_at])
  @@map("tickets")
}

model Analysis {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  analysis_id           String    @unique
  correlation_id        String
  ticket_id             String
  input_snapshot        Json
  classification        Json
  similar_tickets       Json[]
  recommendations       Json[]
  confidence            Json
  clarification_questions String[]
  review_required       Boolean   @default(true)
  review_reasons        String[]
  component_statuses    Json
  status                String    @default("completed")
  model_versions        Json
  execution_latency_ms  Json
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now())

  @@index([ticket_id, created_at])
  @@index([status])
  @@map("analyses")
}

model AnalystFeedback {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  feedback_id        String   @unique
  analysis_id        String
  target_type        String
  target_id          String
  reviewer_reference Json
  feedback_status    String
  comment            String?  @default("")
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now())

  @@index([analysis_id, target_id])
  @@map("analyst_feedbacks")
}

model AuditEvent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  event_id        String   @unique
  correlation_id  String
  analysis_id     String?
  ticket_id       String?
  event_type      String
  actor_reference Json
  component_status String  @default("completed")
  metadata        Json?
  timestamp       DateTime @default(now())

  @@index([correlation_id, timestamp])
  @@index([event_type, timestamp])
  @@map("audit_events")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @unique
  email        String   @unique
  name         String
  password_hash String
  role         String   @default("analyst")
  access_level String   @default("internal")
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  @@map("users")
}

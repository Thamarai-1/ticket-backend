PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/it_ticket_db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=it_ticket_db

# Security & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super-secret-jwt-key-for-it-ticket-analysis
JWT_EXPIRES_IN=24h

# ML / AI Microservices
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# OpenRouter & External AI Providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=openrouter

# Vector Database (Qdrant)
QDRANT_URL=https://your-cluster-id.eu-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=ticket_embeddings
